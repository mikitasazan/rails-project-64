<% content_for :title, t(".sign_in") %>

<h2 class="mb-6 text-2xl font-bold"><%= t(".sign_in") %></h2>

<%= form_with model: resource, as: resource_name, url: session_path(resource_name), class: "contents" do |form| %>
  <div class="my-5">
    <%= form.label :email %>

    <%= form.email_field :email, autofocus: true, autocomplete: "email",
                         class: "mt-2 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
  </div>

  <div class="my-5">
    <%= form.label :password %>

    <%= form.password_field :password, autocomplete: "current-password",
                            class: "mt-2 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="my-5 flex items-center gap-2">
      <%= form.check_box :remember_me, class: "size-5 rounded-md border border-gray-400" %>
      <%= form.label :remember_me %>
    </div>
  <% end %>

  <%= form.submit t(".sign_in"),
                  class: "cursor-pointer rounded-md bg-blue-600 px-3.5 py-2.5 font-medium text-white hover:bg-blue-500" %>
<% end %>

<%= render "devise/shared/links" %>
