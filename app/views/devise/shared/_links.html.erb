<div class="mt-6 flex flex-col gap-2 text-sm">
  <% if controller_name != "sessions" %>
    <%= link_to t(".sign_in"), new_session_path(resource_name), class: "text-blue-600 hover:underline" %>
  <% end %>

  <% if devise_mapping.registerable? && controller_name != "registrations" %>
    <%= link_to t(".sign_up"), new_registration_path(resource_name), class: "text-blue-600 hover:underline" %>
  <% end %>
</div>
