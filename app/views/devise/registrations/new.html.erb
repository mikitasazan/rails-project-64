<% content_for :title, t(".sign_up") %>

<h2 class="mb-6 text-2xl font-bold"><%= t(".sign_up") %></h2>

<%= form_with model: resource, as: resource_name, url: registration_path(resource_name), class: "contents" do |form| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="my-5">
    <%= form.label :email %>

    <%= form.email_field :email, autofocus: true, autocomplete: "email",
                         class: "mt-2 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
  </div>

  <div class="my-5">
    <%= form.label :password %>

    <%= form.password_field :password, autocomplete: "new-password",
                            class: "mt-2 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
  </div>

  <div class="my-5">
    <%= form.label :password_confirmation %>

    <%= form.password_field :password_confirmation, autocomplete: "new-password",
                            class: "mt-2 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
  </div>

  <%= form.submit t(".sign_up"),
                  class: "cursor-pointer rounded-md bg-blue-600 px-3.5 py-2.5 font-medium text-white hover:bg-blue-500" %>
<% end %>

<%= render "devise/shared/links" %>
