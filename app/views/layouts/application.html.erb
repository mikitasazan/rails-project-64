<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("layouts.application.app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module", defer: true %>
  </head>

  <body class="flex min-h-screen flex-col bg-gray-50 text-gray-900">
    <main class="mx-auto my-6 w-full max-w-4xl px-4">
      <%= yield %>
    </main>
  </body>
</html>
