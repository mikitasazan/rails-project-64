<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || t(".app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module", defer: true %>
  </head>

  <body class="flex min-h-full flex-col bg-gray-50 text-gray-900">
    <nav class="mx-auto flex w-full max-w-4xl flex-wrap items-center gap-4 border-b border-gray-200 px-4 py-3">
      <%= link_to t(".app_name"), root_path, class: "mr-auto text-lg font-bold" %>

      <ul class="flex flex-wrap items-center gap-4">
        <% if user_signed_in? %>
          <li class="text-gray-500"><%= current_user.email %></li>
          <li>
            <%= link_to t(".sign_out"), destroy_user_session_path, data: { turbo_method: :delete },
                        class: "font-medium hover:underline" %>
          </li>
        <% else %>
          <li><%= link_to t(".sign_in"), new_user_session_path, class: "font-medium hover:underline" %></li>
          <li><%= link_to t(".sign_up"), new_user_registration_path, class: "font-medium hover:underline" %></li>
        <% end %>
      </ul>
    </nav>

    <main class="mx-auto my-6 w-full max-w-4xl px-4">
      <%= yield %>
    </main>
  </body>
</html>
