<nav class="text-sm text-gray-500">
  <%= link_to t(".all_posts"), root_path, class: "hover:underline" %>
  <span class="mx-2">/</span>
  <span class="text-gray-900"><%= @post.category.name %></span>
</nav>

<article class="mt-6">
  <h1 class="mb-6 text-2xl font-bold"><%= @post.title %></h1>

  <div class="space-y-4"><%= simple_format(@post.body) %></div>

  <p class="mt-10 text-sm text-gray-500">
    <span class="mr-2"><%= @post.creator.email %></span>
    <span><%= distance_of_time_in_words_to_now(@post.created_at) %></span>
  </p>
</article>

<section id="comment-section" class="mt-8">
  <h2 class="text-xl font-bold"><%= t(".comments") %></h2>

  <% if user_signed_in? %>
    <%= form_with model: @form_comment, url: post_comments_path(@post), class: "contents" do |form| %>
      <div class="my-3">
        <%= form.label :content %>

        <%= form.text_area :content, rows: 4,
                            class: "mt-2 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
      </div>

      <%= form.hidden_field :parent_id, value: nil %>

      <%= form.submit class: "cursor-pointer rounded-md bg-blue-600 px-3.5 py-2.5 font-medium text-white hover:bg-blue-500" %>
    <% end %>
  <% end %>

  <% @comments.each do |comment, children| %>
    <%= render "posts/children_comments", comment:, children:, post: @post, form_comment: @form_comment %>
  <% end %>
</section>
