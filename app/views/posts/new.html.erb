<% content_for :title, t(".title") %>

<%= form_with model: @post, class: "contents" do |form| %>
  <div class="my-5">
    <%= form.label :title %>

    <%= form.text_field :title,
                        class: "mt-2 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>

    <p class="mt-1 text-sm text-gray-500"><%= t(".hints.title") %></p>
  </div>

  <div class="my-5">
    <%= form.label :category_id, Post.human_attribute_name(:category) %>

    <%= form.collection_select :category_id, @categories, :id, :name, { prompt: true },
                              class: "mt-2 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
  </div>

  <div class="my-5">
    <%= form.label :body %>

    <%= form.text_area :body, rows: 10,
                        class: "mt-2 block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>

    <p class="mt-1 text-sm text-gray-500"><%= t(".hints.body") %></p>
  </div>

  <%= form.submit t(".submit"),
                  class: "cursor-pointer rounded-md bg-blue-600 px-3.5 py-2.5 font-medium text-white hover:bg-blue-500" %>
<% end %>
