<div id="comment-<%= comment.id %>" class="mt-2 rounded-md border border-gray-200 bg-white">
  <div class="flex flex-wrap items-center gap-2 border-b border-gray-100 px-4 py-2 text-sm">
    <span><%= comment.user.email %></span>
    <span class="text-gray-500"><%= l(comment.created_at, format: :short) %></span>
  </div>

  <div class="px-4 py-3">
    <p><%= comment.content %></p>
  </div>

  <% if user_signed_in? %>
    <div class="px-4 pb-3">
      <%= render "posts/comment_form", comment:, post:, form_comment: %>
    </div>
  <% end %>

  <% children.each do |child, grandchildren| %>
    <div class="ml-4">
      <%= render "posts/children_comments", comment: child, children: grandchildren, post:, form_comment: %>
    </div>
  <% end %>
</div>
