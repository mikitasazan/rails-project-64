<% if user_signed_in? %>
  <details class="ml-2">
    <summary class="cursor-pointer text-sm lowercase underline"><%= t(".response") %></summary>

    <%= form_with model: form_comment, url: post_comments_path(post), class: "contents" do |form| %>
      <div class="my-3">
        <%= form.text_area :content, rows: 3, "aria-label": t(".response"),
                            class: "block w-full rounded-md border border-gray-400 px-3 py-2 shadow-sm focus:outline-blue-600" %>
      </div>

      <%= form.hidden_field :parent_id, value: comment.id %>

      <%= form.submit class: "cursor-pointer rounded-md bg-blue-600 px-3.5 py-2.5 font-medium text-white hover:bg-blue-500" %>
    <% end %>
  </details>
<% end %>
